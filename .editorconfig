# .editorconfig — Rendlio.Analyzers. Root config; nothing is inherited from above.
#
# Enforcement model: Directory.Build.props sets TreatWarningsAsErrors +
# EnforceCodeStyleInBuild, so every "warning" below is build-breaking. "error" is
# reserved for rules that must also scream in the IDE before a build runs.
# The file-level rules (charset, EOL, final newline, trailing whitespace) are the
# ones the compiler cannot see; CI enforces those with `dotnet format`.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown — do not strip them.
trim_trailing_whitespace = false
indent_size = 2

[*.cs]

#### Namespaces & usings ####
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
# Unnecessary usings fail the build (requires GenerateDocumentationFile, which
# Directory.Build.props sets repo-wide).
dotnet_diagnostic.IDE0005.severity = warning

#### var ####
# Explicit types except where the type is literally on the line already.
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning

#### Expression bodies ####
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_indexers = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_lambdas = true:suggestion

#### Braces, patterns, modern C# ####
csharp_prefer_braces = true:error
csharp_style_prefer_switch_expression = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_prefer_simple_using_statement = true:warning
csharp_style_prefer_index_operator = true:warning
csharp_style_prefer_range_operator = true:warning

#### this. ####
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

#### Readonly / immutability ####
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:warning

#### Modifier order ####
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

#### Naming: interfaces prefixed I, types/members PascalCase, private fields _camelCase ####
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.symbols = type_symbol
dotnet_naming_rule.types_are_pascal_case.style = pascal_case_style
dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_symbols.type_symbol.applicable_kinds = class,struct,enum,delegate
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.members_are_pascal_case.symbols = member_symbol
dotnet_naming_rule.members_are_pascal_case.style = pascal_case_style
dotnet_naming_rule.members_are_pascal_case.severity = warning
dotnet_naming_symbols.member_symbol.applicable_kinds = property,method,event

dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

[tests/**/*.cs]
# The fixtures in AnalyzerConventionTests declare DiagnosticAnalyzer subclasses as *data*:
# they are read by reflection and never handed to a compiler. Every rule below assumes the
# opposite — that the enclosing assembly ships as a compiler extension — so all of them are
# noise here and only here. src/Rendlio.Analyzers keeps them on via EnforceExtendedAnalyzerRules.

# Missing [DiagnosticAnalyzer]: one fixture omits it on purpose, to prove the guard notices.
dotnet_diagnostic.RS1001.severity = none
# ConfigureGeneratedCodeAnalysis / EnableConcurrentExecution: no fixture ever analyses anything.
dotnet_diagnostic.RS1025.severity = none
dotnet_diagnostic.RS1026.severity = none
# EnforceExtendedAnalyzerRules: this project is a test host, not a published pack.
dotnet_diagnostic.RS1036.severity = none
# netstandard2.0-only TFM: correct for the pack, impossible for a net10.0 test project.
dotnet_diagnostic.RS1041.severity = none

# Test names read as sentences; the underscores are the point.
dotnet_diagnostic.CA1707.severity = none
