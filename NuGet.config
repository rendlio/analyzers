<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore sources for this repository, pinned rather than inherited.

  Both halves of source resolution are inherited by default, and clearing one without the
  other leaves the pin half-made:

  <packageSources><clear /> drops whatever feeds the machine-level NuGet.config happens to
  define, so a private or mirrored feed on a contributor's box cannot quietly substitute a
  package here. A package that ships to strangers should resolve from exactly one public
  source, and the same one on every machine that builds it.

  <packageSourceMapping><clear /> drops the machine's mapping rules, which say which source
  each package id pattern is allowed to come from. Those rules survive the clear above and
  routinely name feeds this file does not declare — so a contributor whose config maps a
  pattern to a mirror gets NU1101 for a package that is sitting on nuget.org, and the error
  names a missing package rather than the mapping that hid it. Mapping '*' to nuget.org after
  the clear says the same thing the sources list says, in the section NuGet consults second.
-->
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
