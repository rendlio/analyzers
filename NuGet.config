<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore sources for this repository, pinned rather than inherited.

  <clear /> drops whatever feeds the machine-level NuGet.config happens to define, so a
  private or mirrored feed on a contributor's box cannot quietly substitute a package
  here. A package that ships to strangers should resolve from exactly one public source,
  and the same one on every machine that builds it.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
