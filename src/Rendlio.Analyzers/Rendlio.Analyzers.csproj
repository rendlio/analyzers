<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rendlio.Analyzers — two compiler-enforced bans: network APIs, and APIs whose result
    depends on when or where the build runs.

    The rule implementations are developed in the Rendlio engine repository and land here
    on release; see README.md ("Where the rules are developed"). This project file is the
    published shape they land into — target framework, packaging layout and the analyzer
    author rules they must satisfy.
  -->
  <PropertyGroup>
    <!-- A Roslyn host loads analyzer assemblies into the compiler process, which may be
         .NET Framework (VS) or .NET (dotnet build). netstandard2.0 is the only TFM both
         can load — a host requirement, not a policy choice. RS1041 enforces it. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Roslyn's own rules for analyzer authors: no file/console/clock/process access from
         inside an analyzer (RS1035), correct TFM for a compiler extension (RS1041). -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <!-- ============================ Packaging ============================= -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Rendlio.Analyzers</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Roslyn analyzers that ban network APIs and non-deterministic APIs in .NET code. These are how Rendlio proves zero phone-home and byte-identical output on its own engine code at compile time; they are published free for anyone with the same requirements.</Description>
    <PackageTags>roslyn;analyzers;analyzer;determinism;reproducible-builds;no-network;offline;banned-api;codeanalysis</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- An analyzer is a build-time tool: it must not flow to a consumer's consumers, and
         it ships no library for anyone to compile against. -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128: the package carries no lib/ folder by design (analyzers/ only). -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- ====================== Debuggability of the pack ==================== -->
  <PropertyGroup>
    <!-- Why: this package ships exactly ONE file a consumer's toolchain reads —
         analyzers/dotnet/cs/Rendlio.Analyzers.dll — so the only debug information that can
         reach anyone is debug information carried inside that assembly. A portable PDB is a
         separate file, and `IncludeBuildOutput=false` plus a hand-written <None Include> for
         the assembly means nothing else in bin/ is packed: the default leaves a consumer whose
         build hits an analyzer crash with a stack trace of method tokens and nowhere to step.
         Embedded costs ~6.5 KB on an 18 KB assembly and is still byte-reproducible across
         clean runs, which is the one property this pack may not trade away.

         A symbol package is not the alternative that was passed over — it is not available.
         `-p:IncludeSymbols=true` on this project FAILS the pack with NU5017 ("cannot create a
         package that has no dependencies nor content"), because the symbols NuGet would collect
         are those of the build output this project deliberately does not pack. Embedding is the
         only route debug information has into this package's one shipped file.

         SourceLink needs no PackageReference: it is in-box from the .NET 8 SDK onward and
         activates off the RepositoryUrl in Directory.Build.props, so the embedded PDB carries a
         document map back to this repository whenever the checkout has a github.com remote.
         Where it does not — a worktree whose origin is a local path — it degrades to an embedded
         PDB with no map and warns about nothing, which is the correct failure for a convenience.
         EmbedUntrackedSources is stated rather than inherited because the generated sources it
         covers (AssemblyInfo, GlobalUsings) are in every stack trace through this assembly, and
         an SDK default is not a promise this package gets to rely on. -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- The compiler host supplies these at analysis time, so nothing is copied or flowed:
         ExcludeAssets="runtime" keeps the Roslyn binaries out of every consumer's output. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!--
    Release tracking (RS2008): every rule id this assembly reports is declared in one of
    AnalyzerReleases.Shipped.md / AnalyzerReleases.Unshipped.md, so adding or retiring a rule is
    a reviewable diff.

    Neither file is listed as an <AdditionalFiles> here, deliberately.
    Microsoft.CodeAnalysis.Analyzers adds them itself — its own buildTransitive targets include
    each file when it exists in the project directory — so listing them again puts each identity
    in @(AdditionalFiles) twice. The compiler does not mind, but every Roslyn workspace load then
    reports "Duplicate source file", which is what "Warnings were encountered while loading the
    workspace" means when `dotnet format` prints it on an otherwise green run — in a CI log that
    runs format at diagnostic verbosity, so the noise is permanent and points at nothing.

    Leaning on the package's include costs no control, because the include and RS2008 arrive from
    the same package: there is no state in which the files are needed and the include is
    absent. Were a future version to stop adding them, RS2008 would report every shipped rule id as
    untracked and the build would fail under warnings-as-errors — loud, which is the failure mode
    worth having.
  -->

  <ItemGroup>
    <!-- analyzers/dotnet/cs is the path NuGet reads to install a C# analyzer; anything
         elsewhere in the package is inert. -->
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
